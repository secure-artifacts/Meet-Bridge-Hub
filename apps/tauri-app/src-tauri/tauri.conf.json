{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meet Bridge Hub",
  "version": "0.1.3",
  "identifier": "com.meetbridge.hub",
  "build": {
    "frontendDist": "../frontend",
    "beforeBuildCommand": "node ../../scripts/prepare-tauri-sidecar.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Meet Bridge Hub",
        "width": 760,
        "height": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/audio_router_icon.ico"],
    "targets": "all",
    "resources": ["resources"],
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
